---
import {
  getLangFromUrl,
  useTranslations,
  getLocalizedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="events" class="py-20 bg-secondary">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl md:text-5xl font-bold text-center mb-4">
      {t("upcomingEvents.title")}
    </h2>
    <p class="text-center text-lg mb-12 max-w-3xl mx-auto text-secondary-text">
      {t("upcomingEvents.subtitle")}
    </p>

    <!-- Upcoming Events Embed -->
    <div class="flex justify-center">
      <iframe
        src="https://luma.com/embed/calendar/cal-4kTyt96myxtEqxH/events?lt=dark"
        width="100%"
        height="450"
        frameborder="0"
        class="shadow-2xl rounded-2xl shadow-primary w-[600px] md:w-[800px] lg:w-[800px]"
        allowfullscreen=""
        aria-hidden="false"
        tabindex="0"
        title="Upcoming Events"></iframe>
    </div>

    <!-- Past Events -->
    <h3 class="text-2xl md:text-3xl font-bold text-center mt-20 mb-8">
      Past Events
    </h3>
    <div class="flex justify-center">
      <iframe
        src="https://luma.com/embed/calendar/cal-4kTyt96myxtEqxH/events?lt=dark&period=past"
        width="100%"
        height="450"
        frameborder="0"
        class="shadow-2xl rounded-2xl shadow-primary w-[600px] md:w-[800px] lg:w-[800px]"
        allowfullscreen=""
        aria-hidden="false"
        tabindex="0"
        title="Past Events"></iframe>
    </div>
  </div>
</section>
